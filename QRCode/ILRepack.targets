<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Named "NotILRepack" so it does not clash with the package's built-in "ILRepack" target.
       The package's auto-merge globs $(OutputPath)*.dll, which here is the shared CVR Mods folder,
       so we drive the merge ourselves from the resolved dependency set instead. -->
  <Target Name="NotILRepack" AfterTargets="Build">
    <PropertyGroup>
      <DoILRepack>false</DoILRepack>
    </PropertyGroup>
    <ItemGroup>
      <!-- Assemblies the game already ships in its Managed folder; we must never merge our own copies (duplicate System.Memory/Buffers/etc would break type identity at runtime). -->
      <GameProvided Include="$(CVRPATH)\ChilloutVR_Data\Managed\*.dll"/>
      <!-- Runtime assemblies from our NuGet packages (plus their transitive deps), resolved to their package-cache paths. -->
      <MergeInputs Include="@(RuntimeCopyLocalItems)" Condition="'%(Extension)' == '.dll'"/>
      <!-- Prebuilt local assemblies shipped in-project that must also be merged -->
      <MergeInputs Include="$(MSBuildThisFileDirectory)Resources\ZXing.Net.Bindings.0.16.8.0\Bindings\ZXing.Unity3D\netstandard2.0\ZXing.Unity.dll"/>
      <!-- Drop any transitive package dep the game already provides (System.Buffers, System.Memory, etc.) -->
      <MergeInputs Remove="@(GameProvided)" MatchOnMetadata="Filename"/>
      <!-- Search paths for the runtime-provided references we do NOT merge -->
      <IlRepackLibs Include="$(CVRPATH)\MelonLoader\net35\"/>
      <IlRepackLibs Include="$(CVRPATH)\ChilloutVR_Data\Managed\"/>
    </ItemGroup>
    <Message Text="MERGING: @(MergeInputs->'%(Filename)') into $(OutputPath)$(AssemblyName).dll" Importance="High"/>
    <ILRepack Internalize="false" LibraryPath="@(IlRepackLibs)" OutputFile="$(OutputPath)$(AssemblyName).dll" InputAssemblies="$(OutputPath)$(AssemblyName).dll;@(MergeInputs)"/>
  </Target>
</Project>
